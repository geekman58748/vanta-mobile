# ── Vanta runtime config ──────────────────────────────────────────────
# Copy to `.env.local` for local dev. Never commit real values.
#
# ⚠ VITE_* values are compiled into the client JS bundle by Vite. They are kept
# out of *git*, not out of the shipped app — anyone can read the built bundle.
# Treat the relayer token as abuse-deterrence, not authentication.
# Anything that has ever been committed must be rotated.

# ── Web app (Vite) ────────────────────────────────────────────────────
# Helius devnet key (free at dashboard.helius.dev). Leave blank to fall back to
# the public devnet RPC — slower and rate-limited, but needs no signup.
VITE_HELIUS_API_KEY=

# Override endpoints wholesale if you'd rather point somewhere else.
# VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=...
# VITE_RPC_WSS=wss://devnet.helius-rpc.com/?api-key=...
# VITE_INDEXER_URL=https://d2xah7tnhdhcom.cloudfront.net
# VITE_PROVER_URL=https://d21ni15goiip6l.cloudfront.net
# VITE_PUBLIC_RPC=https://api.devnet.solana.com

# Privacy relayer. Local dev: http://localhost:3001
# Production: the public HTTPS URL, e.g. https://vanta-relayer.fly.dev
# On a phone, `localhost` means the phone — it will not reach your laptop.
# Must be HTTPS: the bundled app origin is https and mixed content is blocked.
VITE_RELAYER_URL=http://localhost:3001

# Must match the relayer's RELAYER_TOKEN. Leave blank when running locally.
VITE_RELAYER_TOKEN=

# Devnet faucet — a SEPARATE service (faucet/server.js) with its own wallet,
# never the relayer. Local: http://localhost:3003 ; production: its HTTPS URL.
# Blank = the in-app faucet button says "not configured" instead of failing.
VITE_FAUCET_URL=http://localhost:3003

# ── Relayer server (Node) ─────────────────────────────────────────────
RELAYER_PORT=3001

# Postgres (Neon). Server-side only — never expose this to the client bundle.
# Use the POOLED connection string (host contains `-pooler`).
# Tables are created idempotently on relayer boot; see relayer/schema.sql.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# SOLANA_RPC_URL=https://api.devnet.solana.com

# JSON secret-key array or base58. Takes priority over relayer-keypair.json.
# Required when NODE_ENV=production.
# RELAYER_KEYPAIR=

# REQUIRED in production. Without it /fund is an open faucet and /relay is an
# open gas station. Generate with: openssl rand -hex 32
# RELAYER_TOKEN=

# Comma-separated browser origins allowed to call the relayer.
# CORS_ORIGINS=https://appassets.androidplatform.net,https://your-landing.example

# /fund limits (the endpoint that moves money)
# RELAYER_MAX_FUND_SOL=0.05
# RELAYER_FUND_WINDOW_MS=3600000
# RELAYER_FUND_MAX_PER_WINDOW=10
# RELAYER_FUND_LAMPORTS_PER_WINDOW=500000000

# ── Devnet faucet service (faucet/server.js) ───────────────────────
# Its OWN process and OWN wallet: the relayer only pays network fees, the
# faucet only pays claims, so draining one can never touch the other. It
# replaces Connection.requestAirdrop (rate-limited with -32603), so an empty
# judge wallet can still Shield/send. Hard cap = the faucet wallet balance,
# so fund that wallet with only what you are willing to lose.
# FAUCET_PORT=3003
# FAUCET_TOKEN=                          # else RELAYER_TOKEN; REQUIRED in production
# FAUCET_KEYPAIR=<JSON secret-key array>  # else faucet/faucet-keypair.json
# FAUCET_SOL=0.2                         # per claim
# FAUCET_MAX_PER_ADDRESS_SOL=0.2         # lifetime cap per address
# FAUCET_BUDGET_SOL=2                    # per-process budget ledger (in-memory)

# Refuse to co-sign transactions that touch no allowlisted program. Default on.
# RELAYER_ENFORCE_PROGRAMS=1
# RELAYER_ALLOWED_PROGRAMS=sppU489D7A4U1exNo1oeMGZtLEofq3a6o2fR7UeoWB6,regyS5rkAcw2YzDJCmTwCTHs2s246FXxbmuRZ42u2PD
