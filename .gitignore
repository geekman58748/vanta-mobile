# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# e2e harness test identities (private keys)
.e2e-identities.json

# live-test agent identity (private keys)
.agent-identity.json

# agent A/B shadow-send test wallets (private keys)
.vanta-test-wallets.json
.vanta-test-wallets.json.tmp

# test2-anonymity harness state: burner identities + deposit/payout addresses
.test2-state.json

# ── Android release signing — NEVER commit ──
# Losing the release key means you can never update the dApp Store listing.
deploy/vanta-release.jks
deploy/.keystore-password
*.jks
*.keystore

# Device data pulled off a phone before an uninstall. Contains the shielded
# wallet key from localStorage — a private key, not a build artifact.
deploy/device-backup/

# Secrets — see .env.example. `.env` was NOT ignored before, so any local
deploy credentials would have been staged by a `git add -A`.
.env
.env.*
!.env.example

# Relayer signing key. Was git-tracked; never commit it again.
relayer/relayer-keypair.json

# Devnet faucet key. Holds only the judge-facing demo budget, and is
# deliberately separate from the relayer's fee wallet.
faucet/faucet-keypair.json

# Test/device APKs — build outputs and third-party installs. 100MB+ each;
# committing one permanently bloats the repo and the GitHub push for the
# hackathon submission.
*.apk
*.apks
*.aab
deploy/apk-backup/

# The one APK that IS committed — the landing site serves it at
# /download/vanta.apk, the direct download link on the submission form.
# Without this, a judge clicking that URL gets the SPA fallback HTML.
!landing/public/download/*.apk

# Android build output (the generated project itself IS committed)
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Staged web build bundled into the APK by `npm run bundle:android`.
# Generated from dist/ — never edit by hand. Source of truth is src/.
android/app/src/main/assets/www/
android/.idea/

# Solana Mobile webshell-managed toolchain
.webshell/

# ── Launch video (video/) ──
# The Remotion project IS committed — the code is the point, and it documents how the
# marketing video was made. The rendered MP4s are not: a 14 MB binary belongs in the
# hackathon submission form and on the social post, not in git history.
video/node_modules/
video/out/
video/.remotion/

# Internal process docs — handoffs, plan, GTM, monetization. Kept out of the
# public repo; preserved in git history. Working copies live here.
internal/
