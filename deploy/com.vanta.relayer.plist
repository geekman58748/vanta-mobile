<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vanta.relayer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/mac/vanta-mobile/relayer/server.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/mac/vanta-mobile</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/vanta-relayer.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vanta-relayer.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RELAYER_PORT</key>
        <string>3001</string>
    </dict>
</dict>
</plist>
